# ============================================================================
# Aurora — Variáveis de ambiente
# Copie este arquivo para .env e preencha os valores antes de subir em produção.
# Nunca comite o .env com senhas reais.
# ============================================================================

# --- Ambiente ---
NODE_ENV=production
PORT=4321
APP_URL=https://clinica-aurora.example.com

# --- Banco de dados ---
# Produção: PostgreSQL. Exemplo: postgres://aurora:senha@localhost:5432/aurora?sslmode=require
# Desenvolvimento local: deixe vazio para usar SQLite (node:sqlite, sem dependências).
DATABASE_URL=

# --- Segurança ---
# Chave secreta para JWT/sessões (mínimo 32 caracteres aleatórios).
SESSION_SECRET=troque-esta-chave-por-um-valor-secreto-e-longo
# Bcrypt cost factor (10-12 recomendado).
BCRYPT_ROUNDS=12

# --- Armazenamento de arquivos (fotos, PDFs, XML) ---
# S3 / R2 / MinIO. Deixe vazio para armazenar localmente em ./uploads.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# --- Provedor de NFS-e (fiscal) ---
# Focus NFe, PlugNotas, eNotas ou integração direta na prefeitura.
NFSE_PROVIDER=
NFSE_API_KEY=
NFSE_API_SECRET=
NFSE_MUNICIPALITY_CODE=

# --- Pagamentos / PSP (opcional — baixa automática) ---
# Asaas, Pagar.me, Mercado Pago, Stone, etc.
PSP_PROVIDER=
PSP_API_KEY=
PSP_WEBHOOK_SECRET=

# --- WhatsApp Business API (confirmação, orçamento, recall) ---
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=

# --- E-mail transacional (orçamento, contrato, recibo) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Backup ---
# Caminho para pg_dump (produção) ou vazio para usar o backup integrado.
PG_DUMP_PATH=
# Diretório onde os backups serão gravados.
BACKUP_DIR=./backups
# Retenção de backups em dias.
BACKUP_RETENTION_DAYS=30
